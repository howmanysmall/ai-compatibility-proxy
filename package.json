{
	"name": "ai-compatibility-proxy",
	"version": "0.2.0",
	"private": true,
	"license": "MIT",
	"author": {
		"name": "HowManySmall"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/howmanysmall/ai-compatibility-proxy.git"
	},
	"type": "module",
	"scripts": {
		"biome": "biome",
		"bench": "bun run --bun scripts/http-bench.ts run",
		"build:oxc": "bun run --bun scripts/build-small-rules.ts",
		"commitlint": "commitlint",
		"context7": "ctx7",
		"dev": "bun run --bun --hot src/index.ts",
		"format": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); nr biome check --fix $a && nr oxfmt $a' _",
		"format:check": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); nr biome check --no-errors-on-unmatched $a && nr oxfmt --no-error-on-unmatched-pattern --check $a' _",
		"format:safe": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); nr biome check --no-errors-on-unmatched --fix $a && nr oxfmt --no-error-on-unmatched-pattern $a' _",
		"hooks:install": "hk install --mise",
		"hooks:validate": "hk validate",
		"lint": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); nr oxlint $a && nr biome check $a' _",
		"lint:agent": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); nr oxlint --format agent $a && nr biome check --reporter concise $a' _",
		"lint:safe": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); nr oxlint --no-error-on-unmatched-pattern $a && nr biome check --no-errors-on-unmatched $a' _",
		"live-smoke": "bun run --bun scripts/live-proxy-smoke.ts",
		"oxfmt": "oxfmt",
		"oxlint": "oxlint",
		"skills": "skills",
		"start": "bun run --bun src/index.ts",
		"test": "deno run -A npm:vitest run",
		"test:watch": "deno run -A npm:vitest --coverage.enabled=false",
		"test:fuzz": "vitiate regression --config vitest.vitiate.config.ts",
		"test:fuzz:run": "vitiate fuzz --fuzz-time 10 --config vitest.vitiate.config.ts",
		"test:mutation": "stryker run",
		"type-check": "tsgo --noEmit"
	},
	"dependencies": {
		"arkenv": "^0.12.2",
		"arktype": "^2.2.0",
		"consola": "^3.4.2",
		"effect": "^3.21.2",
		"elysia": "^1.4.28",
		"env-paths": "^4.0.0",
		"pretty-bytes": "^7.1.0",
		"rotating-file-stream": "^3.2.9",
		"type-fest": "^5.7.0"
	},
	"devDependencies": {
		"@antfu/ni": "^30.1.0",
		"@biomejs/biome": "^2.4.16",
		"@cliffy/command": "jsr:^1.1.1",
		"@cliffy/prompt": "jsr:^1.1.1",
		"@commitlint/config-conventional": "^21.0.2",
		"@commitlint/types": "^21.0.1",
		"@faker-js/faker": "catalog:testing",
		"@fast-check/vitest": "^0.4.1",
		"@mitata/counters": "^0.0.8",
		"@oxlint/plugins": "^1.70.0",
		"@pobammer-ts/small-rules": "^1.1.0",
		"@sander/html": "jsr:^0.1.12",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/vitest-runner": "^9.6.1",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.1",
		"@typescript-eslint/parser": "^8.61.1",
		"@typescript/native-preview": "latest",
		"@vitest/coverage-v8": "catalog:testing",
		"@vitiate/core": "^0.3.0",
		"@vitiate/fuzzed-data-provider": "^0.3.0",
		"colorette": "^2.0.20",
		"commitlint": "^21.0.2",
		"ctx7": "^0.5.2",
		"eslint-plugin-antfu": "^3.2.3",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-regexp": "^3.1.0",
		"eslint-plugin-sonarjs": "^4.0.3",
		"eslint-plugin-unused-imports": "^4.4.1",
		"fast-check": "^4.8.0",
		"jiti": "^2.7.0",
		"knip": "^6.15.0",
		"mitata": "^1.0.34",
		"oxc-parser": "^0.136.0",
		"oxc-resolver": "^11.20.0",
		"oxfmt": "^0.55.0",
		"oxlint": "^1.70.0",
		"oxlint-plugin-utilities": "^1.0.0",
		"oxlint-tsgolint": "^0.23.0",
		"package-manager-detector": "1.6.0",
		"pretty-ms": "^9.3.0",
		"sfw": "^2.0.6",
		"skills": "^1.5.11",
		"sury": "11.0.0-alpha.8",
		"tsdown": "0.22.2",
		"typebox": "^1.2.11",
		"typescript": "^6.0.3",
		"valibot": "^1.4.1",
		"vitest": "catalog:testing",
		"vitiate": "^0.3.0",
		"zod": "^4.4.3",
		"zx": "^8.8.5"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"packageManager": "aube@1.21.0"
}
