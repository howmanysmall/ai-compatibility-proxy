{
	"allowScripts": false,
	"bench": {
		"include": ["benchmarks/**"]
	},
	"compilerOptions": {
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"checkJs": false,
		"exactOptionalPropertyTypes": true,
		"jsx": "react-jsx",
		"lib": ["deno.window", "deno.unstable", "esnext", "node"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noPropertyAccessFromIndexSignature": false,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"paths": {
			"@constants/*": ["./src/constants/*"],
			"@logging/*": ["./src/logging/*"],
			"@polyfills/*": ["./src/polyfills/*"],
			"@providers/*": ["./src/providers/*"],
			"@proxy/*": ["./src/proxy/*"],
			"@ts-types/*": ["./src/types/*"],
			"@utilities/*": ["./src/utilities/*"],
			"@validators/*": ["./src/validators/*"]
		},
		"skipLibCheck": true,
		"strict": true,
		"strictBindCallApply": true,
		"strictBuiltinIteratorReturn": true,
		"strictFunctionTypes": true,
		"strictNullChecks": true,
		"strictPropertyInitialization": true,
		"types": [],
		"useUnknownInCatchVariables": true,
		"verbatimModuleSyntax": true
	},
	"exclude": [".repos"],
	"exports": {},
	"fmt": {
		"bracePosition": "sameLine",
		"exclude": [
			".repos",
			".agents/skills/oxlint-rule-creator/SKILL.md",
			".vscode/mcp.json",
			"AGENTS.md",
			"plugins/oxc/small-rules.js",
			"plugins/oxc/small-rules/utilities/prevent-abbreviations/replacements.ts",
			"skills-lock.json",
			".github/workflows/*.yml"
		],
		"indentWidth": 4,
		"jsx.bracketPosition": "nextLine",
		"jsx.multiLineParens": "prefer",
		"lineWidth": 120,
		"newLineKind": "lf",
		"nextControlFlowPosition": "sameLine",
		"operatorPosition": "sameLine",
		"proseWrap": "preserve",
		"quoteProps": "asNeeded",
		"semiColons": true,
		"singleBodyPosition": "sameLine",
		"singleQuote": false,
		"spaceAround": false,
		"spaceSurroundingProperties": true,
		"trailingCommas": "onlyMultiLine",
		"typeLiteral.separatorKind": "semiColon",
		"useBraces": "whenNotSingleLine",
		"useTabs": true
	},
	"imports": {
		"@biomejs/biome": "npm:@biomejs/biome@^2.4.15",
		"@commitlint/config-conventional": "npm:@commitlint/config-conventional@^21.0.1",
		"@commitlint/types": "npm:@commitlint/types@^21.0.1",
		"@constants/": "./src/constants/",
		"@faker-js/faker": "npm:@faker-js/faker@^10.4.0",
		"@logging/": "./src/logging/",
		"@oxc-project/types": "npm:@oxc-project/types@^0.133.0",
		"@oxlint/plugins": "npm:@oxlint/plugins@^1.66.0",
		"@polyfills/": "./src/polyfills/",
		"@providers/": "./src/providers/",
		"@proxy/": "./src/proxy/",
		"@sander/html": "jsr:@sander/html@0.1.12",
		"@std/crypto": "jsr:@std/crypto@^1.1.0",
		"@std/dotenv": "jsr:@std/dotenv@^0.225.6",
		"@std/fmt": "jsr:@std/fmt@^1.0.10",
		"@std/path": "jsr:@std/path@^1.1.4",
		"@total-typescript/ts-reset": "npm:@total-typescript/ts-reset@^0.6.1",
		"@ts-types/": "./src/types/",
		"@types/node": "npm:@types/node@^25.9.1",
		"@typescript/native-preview": "npm:@typescript/native-preview@^7.0.0-dev.20260522.1",
		"@utilities/": "./src/utilities/",
		"@validators/": "./src/validators/",
		"arkenv": "npm:arkenv@^0.11.0",
		"arktype": "npm:arktype@^2.2.0",
		"commitlint": "npm:commitlint@^21.0.1",
		"consola": "npm:consola@^3.4.2",
		"effect": "npm:effect@^3.21.2",
		"env-paths": "npm:env-paths@^4.0.0",
		"eslint-plugin-antfu": "npm:eslint-plugin-antfu@^3.2.3",
		"eslint-plugin-regexp": "npm:eslint-plugin-regexp@^3.1.0",
		"eslint-plugin-sonarjs": "npm:eslint-plugin-sonarjs@^4.0.3",
		"eslint-plugin-unused-imports": "npm:eslint-plugin-unused-imports@^4.4.1",
		"hono": "jsr:@hono/hono@4.12.23",
		"oxfmt": "npm:oxfmt@^0.52.0",
		"oxlint": "npm:oxlint@^1.66.0",
		"oxlint-tsgolint": "npm:oxlint-tsgolint@^0.23.0",
		"pretty-bytes": "npm:pretty-bytes@^7.1.0",
		"pretty-ms": "npm:pretty-ms@^9.3.0",
		"rotating-file-stream": "npm:rotating-file-stream@^3.2.9",
		"skills": "npm:skills@^1.5.7",
		"tsdown": "npm:tsdown@^0.22.0",
		"type-fest": "npm:type-fest@^5.6.0"
	},
	"license": "MIT",
	"lint": {
		"exclude": [".repos", "**/*.js"],
		"report": "pretty",
		"rules": {
			"exclude": ["require-await"],
			"tags": ["recommended", "workspace", "react", "jsx", "jsr"]
		}
	},
	"lock": true,
	"minimumDependencyAge": {
		"age": "P3D",
		"exclude": [
			"npm:@biomejs/biome",
			"npm:sury",
			"npm:oxfmt",
			"npm:oxlint",
			"npm:oxlint-tsgolint",
			"npm:@oxfmt/binding-android-arm-eabi",
			"npm:@oxfmt/binding-android-arm64",
			"npm:@oxfmt/binding-darwin-arm64",
			"npm:@oxfmt/binding-linux-arm64-gnu",
			"npm:@oxfmt/binding-linux-arm64-musl",
			"npm:@oxfmt/binding-linux-ppc64-gnu",
			"npm:@oxfmt/binding-linux-ppc64-musl",
			"npm:@oxfmt/binding-linux-riscv64-gnu",
			"npm:@oxfmt/binding-linux-riscv64-musl",
			"npm:@oxfmt/binding-linux-s390x-gnu",
			"npm:@oxfmt/binding-linux-x64-gnu",
			"npm:@oxfmt/binding-linux-x64-musl",
			"npm:@oxfmt/binding-openharmony-arm64",
			"npm:@oxfmt/binding-win32-arm64-msvc",
			"npm:@oxfmt/binding-darwin-x64",
			"npm:@oxfmt/binding-freebsd-x64",
			"npm:@oxfmt/binding-linux-arm-gnueabihf",
			"npm:@oxfmt/binding-linux-arm-musleabihf",
			"npm:@oxfmt/binding-win32-ia32-msvc",
			"npm:@oxfmt/binding-win32-x64-msvc",
			"npm:@oxlint/binding-android-arm-eabi",
			"npm:@oxlint/binding-android-arm64",
			"npm:@oxlint/binding-darwin-arm64",
			"npm:@oxlint/binding-linux-arm64-gnu",
			"npm:@oxlint/binding-linux-arm64-musl",
			"npm:@oxlint/binding-linux-ppc64-gnu",
			"npm:@oxlint/binding-linux-ppc64-musl",
			"npm:@oxlint/binding-linux-riscv64-gnu",
			"npm:@oxlint/binding-linux-riscv64-musl",
			"npm:@oxlint/binding-linux-s390x-gnu",
			"npm:@oxlint/binding-linux-x64-gnu",
			"npm:@oxlint/binding-linux-x64-musl",
			"npm:@oxlint/binding-openharmony-arm64",
			"npm:@oxlint/binding-win32-arm64-msvc",
			"npm:@oxlint/binding-darwin-x64",
			"npm:@oxlint/binding-freebsd-x64",
			"npm:@oxlint/binding-linux-arm-gnueabihf",
			"npm:@oxlint/binding-linux-arm-musleabihf",
			"npm:@oxlint/binding-win32-ia32-msvc",
			"npm:@oxlint/binding-win32-x64-msvc"
		]
	},
	"name": "api-conversion",
	"nodeModulesDir": "auto",
	"publish": {
		"exclude": ["**"]
	},
	"tasks": {
		"biome": "biome",
		"build:oxc": "deno run --allow-env --allow-ffi --allow-read --allow-write --allow-run ./scripts/build-small-rules.ts",
		"commitlint": "commitlint",
		"context7": "deno run -A npm:ctx7",
		"dev": "deno run --allow-net --allow-env --allow-sys --allow-write --allow-read src/index.ts",
		"format": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); deno task biome check --fix $a && deno task oxfmt $a && deno fmt $a' _",
		"format:check": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); deno task biome check --no-errors-on-unmatched $a && deno task oxfmt --no-error-on-unmatched-pattern --check $a && deno fmt --permit-no-files --check $a' _",
		"format:safe": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); deno task biome check --no-errors-on-unmatched --fix $a && deno task oxfmt --no-error-on-unmatched-pattern $a && deno fmt --permit-no-files $a' _",
		"hooks:install": "hk install",
		"hooks:validate": "hk validate",
		"lint": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); deno task oxlint $a && deno task biome check $a && deno lint $a' _",
		"lint:safe": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); deno task oxlint --no-error-on-unmatched-pattern $a && deno task biome check --no-errors-on-unmatched $a && deno lint --permit-no-files $a' _",
		"oxfmt": "oxfmt",
		"oxlint": "oxlint",
		"skills": "skills",
		"test": "deno test --coverage --trace-leaks --fail-fast --clean --parallel",
		"type-check": "deno check"
	},
	"test": {
		"include": ["tests/**/*.test.ts"],
		"sanitizeOps": true,
		"sanitizeResources": true
	},
	"vendor": false,
	"version": "0.1.0",
	"workspace": ["./plugins/", "./scripts/", "./benchmarks/"]
}
