PORT=8000
UPSTREAM_PROTOCOL=anthropic_messages
UPSTREAM_BASE_URL=https://opencode.ai/zen/go/v1
UPSTREAM_AUTH_MODE=client_bearer
UPSTREAM_AUTH_HEADER=x-api-key
UPSTREAM_API_KEY=
PROXY_API_KEY=
DEFAULT_MODEL=minimax-m3
DEFAULT_MAX_TOKENS=4096
REQUEST_TIMEOUT_MS=60000
OPENCODE_MODELS_URL=https://models.dev/api.json
OPENCODE_MODELS_CACHE_TTL_MS=300000
OPENCODE_MODELS_FETCH_TIMEOUT_MS=2000
LOG_LEVEL=info
CEREBRAS_STRICT_REQUEST_VALIDATION=true
CEREBRAS_DROP_UNSUPPORTED_FIELDS=true
