{
	"compilerOptions": {
		"allowImportingTsExtensions": false,
		"noEmit": true,
		"noEmitOnError": true,
		"outDir": "./plugins/oxc",
		"paths": {
			"$oxlint-rules/*": ["./plugins/oxc/small-rules/rules/*"],
			"$oxlint-types/*": ["./plugins/oxc/small-rules/types/*"],
			"$oxlint-utilities/*": ["./plugins/oxc/small-rules/utilities/*"],
			"$small-rules": ["./plugins/oxc/small-rules/index.ts"]
		},
		"rootDir": ".",
		"sourceMap": false,
		"tsBuildInfoFile": "./node_modules/.tsbuildinfo-plugins"
	},
	"exclude": ["**/node_modules/**"],
	"extends": "./tsconfig.base.json",
	"include": ["./plugins/oxc/**/*.ts", "./tests/small-rules/**/*.ts"]
}
