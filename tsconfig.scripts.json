{
	"compilerOptions": {
		"allowImportingTsExtensions": false,
		"noEmit": true,
		"paths": {
			"@build-plugins/*": ["./scripts/plugins/*"],
			"@build-polyfills/*": ["./scripts/polyfills/*"],
			"@build-utilities/*": ["./scripts/build-utilities/*"],
			"@constants/*": ["./src/constants/*"],
			"@logging/*": ["./src/logging/*"],
			"@polyfills/*": ["./src/polyfills/*"],
			"@providers/*": ["./src/providers/*"],
			"@proxy/*": ["./src/proxy/*"],
			"@ts-types/*": ["./src/types/*"],
			"@utilities/*": ["./src/utilities/*"],
			"@validators/*": ["./src/validators/*"]
		},
		"rootDir": ".",
		"sourceMap": false,
		"tsBuildInfoFile": "./node_modules/.tsbuildinfo-scripts"
	},
	"extends": "./tsconfig.base.json",
	"include": ["scripts/**/*.ts"]
}
